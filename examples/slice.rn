// slice.rn — string indexing + slicing.
// Run with `rune run examples/slice.rn`
// or compile with `rune build examples/slice.rn --release`.

fn main() -> i64 {
    let greeting = "Hello, world!";
    print(greeting);
    print(greeting.len());

    // Slice out "world".
    print(greeting[7..12]);

    // Inclusive slice.
    print(greeting[7..=11]);

    // Byte index — ASCII 'H' = 72.
    print(greeting[0]);

    0
}
