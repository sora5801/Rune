// Session 129 — extends the session-128 lexer with multi-char
// operators (==, !=, <=, >=, &&, ||, ::, ->, =>) and keyword
// recognition (fn, let, if, else, while, for, return, match,
// struct, enum, trait, impl, pub, mod, use, mut, as, in, true,
// false, break, continue).
//
// The single-char token set and core tokenize loop carry over
// from session 128; this session bolts on:
//   - Lookahead via `peek_byte(src, j, n)` for the `=`/`!`/`<`/
//     `>`/`&`/`|`/`:`/`-` lead bytes that may form 2-char tokens.
//   - `keyword_of(name) -> Token` that maps a recognized keyword
//     lexeme to its Token, falling through to `Token::Ident(name)`
//     for non-keywords.
//
// Still NOT here (future sessions): string/char literals, float
// literals, numeric suffixes, comments, source spans.

pub enum Token {
    Ident(str),
    Int(i64, str),

    // Single-char operators and punctuation.
    LParen, RParen, LBrace, RBrace,
    Plus, Minus, Star, Slash, Percent,
    Eq, Semi, Comma, Dot,
    Lt, Gt, Bang, Amp, Pipe, Colon,

    // Multi-char operators.
    EqEq, BangEq, LtEq, GtEq,
    AmpAmp, PipePipe,
    ColonColon, Arrow, FatArrow,

    // Keywords. The lexer reclassifies a matching Ident lexeme
    // into one of these via `keyword_of`.
    Fn, Let, If, Else, While, For, Return, Match,
    Struct, Enum, Trait, Impl, Pub, Mod, Use, Mut, As, In,
    True, False, Break, Continue,

    // Session 130: literals. Str carries the decoded contents
    // (escape sequences already resolved); Char carries the
    // single byte for ASCII-range chars.
    Str(str),
    Char(u8),

    // Session 131: float literals. Carries the parsed f64 value;
    // an optional suffix lexeme (`""` for unsuffixed) signals
    // `f32` / `f64`. The Int variant gains a parallel suffix slot
    // for `i8`/`i32`/`u64`/etc. — replacing session 128's plain
    // `Int(i64)` with `Int(i64, str)`.
    //
    // NOTE: session 131 redefines `Int(i64)` to `Int(i64, str)`.
    // Tests that match `Int(v)` need to become `Int(v, _)`.
    Float(f64, str),

    Eof,
    Error(str),
}

// ---- character classifiers ----

fn is_whitespace(b: u8) -> bool {
    b == 32u8 || b == 9u8 || b == 10u8 || b == 13u8
}
fn is_digit(b: u8) -> bool { b >= 48u8 && b <= 57u8 }
fn is_alpha(b: u8) -> bool {
    (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8) || b == 95u8
}
fn is_alnum(b: u8) -> bool { is_alpha(b) || is_digit(b) }

// Bounds-safe lookahead. Returns 0 when j is past the end, which
// is fine because no legitimate operator's continuation byte is 0.
fn peek_byte(src: str, j: i64, n: i64) -> u8 {
    if j < n { src.byte_at(j) } else { 0u8 }
}

// Session 130: decode an escape sequence's second byte (the one
// after `\`) to its literal byte value. Returns 0 for unknown
// escapes — callers treat 0 as a sentinel meaning "reject." No
// legitimate escape in this table maps to 0 (\0 / NUL is omitted
// intentionally, freeing 0 for the sentinel; the bootstrap source
// doesn't need embedded NULs).
fn decode_escape(e: u8) -> u8 {
    if e == 110u8 { return 10u8; }       // \n → LF
    if e == 116u8 { return 9u8; }        // \t → TAB
    if e == 114u8 { return 13u8; }       // \r → CR
    if e == 92u8  { return 92u8; }       // \\ → \
    if e == 34u8  { return 34u8; }       // \" → "
    if e == 39u8  { return 39u8; }       // \' → '
    0u8                                  // unknown
}

// Session 131: is the alnum run starting after a digit-run a
// recognized numeric suffix? Same set Rune's existing lexer
// accepts (session 088): the 10 sized integer types + isize /
// usize + the two float widths.
fn is_numeric_suffix(s: str) -> bool {
    s == "i8" || s == "i16" || s == "i32" || s == "i64" || s == "isize"
        || s == "u8" || s == "u16" || s == "u32" || s == "u64" || s == "usize"
        || s == "f32" || s == "f64"
}

// ---- keyword recognition ----
//
// Maps a recognized keyword lexeme to its Token; returns
// Token::Ident(name) for non-keywords. The order here doesn't
// matter — match arms are checked sequentially but each compares
// against a distinct literal. A real lexer would speed this up
// with a hash, but for v0.x's bootstrap a 22-arm match is fine.
pub fn keyword_of(name: str) -> Token {
    if name == "fn" { return Token::Fn; }
    if name == "let" { return Token::Let; }
    if name == "if" { return Token::If; }
    if name == "else" { return Token::Else; }
    if name == "while" { return Token::While; }
    if name == "for" { return Token::For; }
    if name == "return" { return Token::Return; }
    if name == "match" { return Token::Match; }
    if name == "struct" { return Token::Struct; }
    if name == "enum" { return Token::Enum; }
    if name == "trait" { return Token::Trait; }
    if name == "impl" { return Token::Impl; }
    if name == "pub" { return Token::Pub; }
    if name == "mod" { return Token::Mod; }
    if name == "use" { return Token::Use; }
    if name == "mut" { return Token::Mut; }
    if name == "as" { return Token::As; }
    if name == "in" { return Token::In; }
    if name == "true" { return Token::True; }
    if name == "false" { return Token::False; }
    if name == "break" { return Token::Break; }
    if name == "continue" { return Token::Continue; }
    Token::Ident(name)
}

// ---- main tokenizer ----

pub fn tokenize(src: str) -> Vec<Token> {
    let tokens: Vec<Token> = vec_new();
    let mut i: i64 = 0;
    let n: i64 = src.len();
    while i < n {
        let b: u8 = src.byte_at(i);

        if is_whitespace(b) {
            i = i + 1;
            continue;
        }

        // Numeric literal — int or float, optionally suffixed.
        // Session 131: extends session 128's digit-run with:
        //   - `.` followed by digit → continue into fractional part
        //   - `e`/`E` followed by optional `+`/`-` and digits → exponent
        //   - trailing `i8`/`i32`/...`f32`/`f64` suffix scan
        if is_digit(b) {
            let int_start: i64 = i;
            let mut j: i64 = i;
            while j < n && is_digit(src.byte_at(j)) {
                j = j + 1;
            }
            let mut is_float: bool = false;
            // Fractional part: `.` followed by at least one digit.
            // `1.method()` (dot followed by alpha) stays an int.
            if j < n && src.byte_at(j) == 46u8 {   // '.'
                if j + 1 < n && is_digit(src.byte_at(j + 1)) {
                    is_float = true;
                    j = j + 1;
                    while j < n && is_digit(src.byte_at(j)) {
                        j = j + 1;
                    }
                }
            }
            // Exponent: `e`/`E`, optional `+`/`-`, then digits.
            if j < n {
                let eb: u8 = src.byte_at(j);
                if eb == 101u8 || eb == 69u8 {   // 'e' or 'E'
                    let mut k: i64 = j + 1;
                    if k < n {
                        let sb: u8 = src.byte_at(k);
                        if sb == 43u8 || sb == 45u8 {   // '+' or '-'
                            k = k + 1;
                        }
                    }
                    if k < n && is_digit(src.byte_at(k)) {
                        is_float = true;
                        j = k;
                        while j < n && is_digit(src.byte_at(j)) {
                            j = j + 1;
                        }
                    }
                }
            }
            let num_end: i64 = j;
            // Suffix: `i8`/`i16`/`i32`/`i64`/`isize`/`u8`/`u16`/
            // `u32`/`u64`/`usize`/`f32`/`f64`. Scan the alnum run
            // starting here and accept it as a suffix only if it
            // matches one of those exact strings.
            let suf_start: i64 = j;
            while j < n && is_alnum(src.byte_at(j)) {
                j = j + 1;
            }
            let suffix: str = if suf_start < j { src[suf_start..j] } else { "" };
            let is_known_suffix: bool = is_numeric_suffix(suffix);
            if suf_start < j && !is_known_suffix {
                // Not a known suffix — back off and let the alnum
                // run be tokenized separately (e.g., `1xyz` produces
                // Int(1, "") + Ident("xyz") rather than Error).
                j = suf_start;
            }
            // `f32`/`f64` on an integer body forces it to be a float.
            let suf_forces_float: bool = is_known_suffix
                && (suffix == "f32" || suffix == "f64");
            let final_is_float: bool = is_float || suf_forces_float;
            let suffix_payload: str = if suf_start < j { suffix } else { "" };
            if final_is_float {
                let v: f64 = f64::from_str(src[int_start..num_end]);
                tokens.push(Token::Float(v, suffix_payload));
            } else {
                let v: i64 = i64::from_str(src[int_start..num_end]);
                tokens.push(Token::Int(v, suffix_payload));
            }
            i = j;
            continue;
        }

        // Identifier-or-keyword.
        if is_alpha(b) {
            let mut j: i64 = i;
            while j < n && is_alnum(src.byte_at(j)) {
                j = j + 1;
            }
            tokens.push(keyword_of(src[i..j]));
            i = j;
            continue;
        }

        // Session 130: string literal `"..."`. Scan bytes until
        // the closing `"`, decoding `\n`, `\t`, `\\`, `\"`, `\'`
        // escape sequences along the way. Unterminated strings
        // (EOF before the close) produce Token::Error.
        if b == 34u8 {   // '"'
            let buf: String = String::new();
            let mut j: i64 = i + 1;
            let mut closed: bool = false;
            while j < n {
                let c: u8 = src.byte_at(j);
                if c == 34u8 { closed = true; j = j + 1; break; }
                if c == 92u8 {   // backslash — escape sequence
                    if j + 1 >= n { break; }
                    let e: u8 = src.byte_at(j + 1);
                    let decoded: u8 = decode_escape(e);
                    if decoded == 0u8 {
                        // Unknown escape: leave Error and stop.
                        tokens.push(Token::Error(src[i..j+2]));
                        j = j + 2;
                        closed = true;   // skip the normal Str push
                        break;
                    }
                    buf.push_byte(decoded);
                    j = j + 2;
                    continue;
                }
                buf.push_byte(c);
                j = j + 1;
            }
            if !closed {
                tokens.push(Token::Error(src[i..n]));
                i = n;
                continue;
            }
            // If we already pushed an Error (unknown-escape path),
            // the buf isn't a complete string — skip the push.
            // The closed-via-quote path falls through here.
            let last_was_error: bool = if tokens.len() == 0 { false } else {
                match tokens.get(tokens.len() - 1) {
                    Token::Error(_) => true,
                    _ => false,
                }
            };
            if !last_was_error {
                tokens.push(Token::Str(buf.to_str()));
            }
            i = j;
            continue;
        }

        // Session 130: char literal `'x'` or `'\\n'`. One ASCII
        // byte (or escape sequence) between single quotes. Multi-
        // byte UTF-8 char or unterminated literal produce Error.
        if b == 39u8 {   // '\''
            if i + 2 >= n {
                tokens.push(Token::Error(src[i..n]));
                i = n;
                continue;
            }
            let c: u8 = src.byte_at(i + 1);
            let ch_byte: u8 = if c == 92u8 {
                // Escape sequence: two bytes after the open quote.
                if i + 3 >= n {
                    tokens.push(Token::Error(src[i..n]));
                    i = n;
                    continue;
                }
                let e: u8 = src.byte_at(i + 2);
                let d: u8 = decode_escape(e);
                if d == 0u8 {
                    tokens.push(Token::Error(src[i..i+4]));
                    i = i + 4;
                    continue;
                }
                d
            } else {
                c
            };
            // Confirm the closing quote.
            let close_pos: i64 = if c == 92u8 { i + 3 } else { i + 2 };
            if close_pos >= n || src.byte_at(close_pos) != 39u8 {
                tokens.push(Token::Error(src[i..n]));
                i = n;
                continue;
            }
            tokens.push(Token::Char(ch_byte));
            i = close_pos + 1;
            continue;
        }

        // Two-char operators. Lookahead at i+1; if it matches a
        // two-char shape, consume two bytes; otherwise produce
        // the one-char fallback.
        let next: u8 = peek_byte(src, i + 1, n);

        // `==`, `=`, `=>`
        if b == 61u8 {           // '='
            if next == 61u8 {    // "=="
                tokens.push(Token::EqEq);
                i = i + 2;
                continue;
            }
            if next == 62u8 {    // "=>"
                tokens.push(Token::FatArrow);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Eq);
            i = i + 1;
            continue;
        }

        // `!=`, `!`
        if b == 33u8 {           // '!'
            if next == 61u8 {
                tokens.push(Token::BangEq);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Bang);
            i = i + 1;
            continue;
        }

        // `<=`, `<`
        if b == 60u8 {
            if next == 61u8 {
                tokens.push(Token::LtEq);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Lt);
            i = i + 1;
            continue;
        }

        // `>=`, `>`
        if b == 62u8 {
            if next == 61u8 {
                tokens.push(Token::GtEq);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Gt);
            i = i + 1;
            continue;
        }

        // `&&`, `&`
        if b == 38u8 {
            if next == 38u8 {
                tokens.push(Token::AmpAmp);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Amp);
            i = i + 1;
            continue;
        }

        // `||`, `|`
        if b == 124u8 {
            if next == 124u8 {
                tokens.push(Token::PipePipe);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Pipe);
            i = i + 1;
            continue;
        }

        // `::`, `:`
        if b == 58u8 {
            if next == 58u8 {
                tokens.push(Token::ColonColon);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Colon);
            i = i + 1;
            continue;
        }

        // `->`, `-`
        if b == 45u8 {
            if next == 62u8 {
                tokens.push(Token::Arrow);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Minus);
            i = i + 1;
            continue;
        }

        // Plain single-char operators / punctuation.
        let t: Token = match b {
            40u8 => Token::LParen,
            41u8 => Token::RParen,
            123u8 => Token::LBrace,
            125u8 => Token::RBrace,
            43u8 => Token::Plus,
            42u8 => Token::Star,
            47u8 => Token::Slash,
            37u8 => Token::Percent,
            59u8 => Token::Semi,
            44u8 => Token::Comma,
            46u8 => Token::Dot,
            _ => Token::Error(src[i..i+1]),
        };
        tokens.push(t);
        i = i + 1;
    }
    tokens.push(Token::Eof);
    tokens
}

// Convenience for tests: a stable string label per token kind.
// Tests compare against these labels rather than reaching into
// variant payloads, keeping them robust to enum reordering.
pub fn kind_of(t: Token) -> str {
    match t {
        Token::Ident(_) => "Ident",
        Token::Int(_, _) => "Int",
        Token::Float(_, _) => "Float",
        Token::LParen => "LParen", Token::RParen => "RParen",
        Token::LBrace => "LBrace", Token::RBrace => "RBrace",
        Token::Plus => "Plus", Token::Minus => "Minus",
        Token::Star => "Star", Token::Slash => "Slash", Token::Percent => "Percent",
        Token::Eq => "Eq", Token::Semi => "Semi", Token::Comma => "Comma",
        Token::Dot => "Dot",
        Token::Lt => "Lt", Token::Gt => "Gt", Token::Bang => "Bang",
        Token::Amp => "Amp", Token::Pipe => "Pipe", Token::Colon => "Colon",
        Token::EqEq => "EqEq", Token::BangEq => "BangEq",
        Token::LtEq => "LtEq", Token::GtEq => "GtEq",
        Token::AmpAmp => "AmpAmp", Token::PipePipe => "PipePipe",
        Token::ColonColon => "ColonColon",
        Token::Arrow => "Arrow", Token::FatArrow => "FatArrow",
        Token::Fn => "Fn", Token::Let => "Let", Token::If => "If",
        Token::Else => "Else", Token::While => "While", Token::For => "For",
        Token::Return => "Return", Token::Match => "Match",
        Token::Struct => "Struct", Token::Enum => "Enum",
        Token::Trait => "Trait", Token::Impl => "Impl",
        Token::Pub => "Pub", Token::Mod => "Mod", Token::Use => "Use",
        Token::Mut => "Mut", Token::As => "As", Token::In => "In",
        Token::True => "True", Token::False => "False",
        Token::Break => "Break", Token::Continue => "Continue",
        Token::Str(_) => "Str",
        Token::Char(_) => "Char",
        Token::Eof => "Eof",
        Token::Error(_) => "Error",
    }
}
