// Session 129 — extends the session-128 lexer with multi-char
// operators (==, !=, <=, >=, &&, ||, ::, ->, =>) and keyword
// recognition (fn, let, if, else, while, for, return, match,
// struct, enum, trait, impl, pub, mod, use, mut, as, in, true,
// false, break, continue).
//
// The single-char token set and core tokenize loop carry over
// from session 128; this session bolts on:
//   - Lookahead via `peek_byte(src, j, n)` for the `=`/`!`/`<`/
//     `>`/`&`/`|`/`:`/`-` lead bytes that may form 2-char tokens.
//   - `keyword_of(name) -> Token` that maps a recognized keyword
//     lexeme to its Token, falling through to `Token::Ident(name)`
//     for non-keywords.
//
// Still NOT here (future sessions): string/char literals, float
// literals, numeric suffixes, comments, source spans.

pub enum Token {
    Ident(str),
    Int(i64),

    // Single-char operators and punctuation.
    LParen, RParen, LBrace, RBrace,
    Plus, Minus, Star, Slash, Percent,
    Eq, Semi, Comma, Dot,
    Lt, Gt, Bang, Amp, Pipe, Colon,

    // Multi-char operators.
    EqEq, BangEq, LtEq, GtEq,
    AmpAmp, PipePipe,
    ColonColon, Arrow, FatArrow,

    // Keywords. The lexer reclassifies a matching Ident lexeme
    // into one of these via `keyword_of`.
    Fn, Let, If, Else, While, For, Return, Match,
    Struct, Enum, Trait, Impl, Pub, Mod, Use, Mut, As, In,
    True, False, Break, Continue,

    Eof,
    Error(str),
}

// ---- character classifiers ----

fn is_whitespace(b: u8) -> bool {
    b == 32u8 || b == 9u8 || b == 10u8 || b == 13u8
}
fn is_digit(b: u8) -> bool { b >= 48u8 && b <= 57u8 }
fn is_alpha(b: u8) -> bool {
    (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8) || b == 95u8
}
fn is_alnum(b: u8) -> bool { is_alpha(b) || is_digit(b) }

// Bounds-safe lookahead. Returns 0 when j is past the end, which
// is fine because no legitimate operator's continuation byte is 0.
fn peek_byte(src: str, j: i64, n: i64) -> u8 {
    if j < n { src.byte_at(j) } else { 0u8 }
}

// ---- keyword recognition ----
//
// Maps a recognized keyword lexeme to its Token; returns
// Token::Ident(name) for non-keywords. The order here doesn't
// matter — match arms are checked sequentially but each compares
// against a distinct literal. A real lexer would speed this up
// with a hash, but for v0.x's bootstrap a 22-arm match is fine.
pub fn keyword_of(name: str) -> Token {
    if name == "fn" { return Token::Fn; }
    if name == "let" { return Token::Let; }
    if name == "if" { return Token::If; }
    if name == "else" { return Token::Else; }
    if name == "while" { return Token::While; }
    if name == "for" { return Token::For; }
    if name == "return" { return Token::Return; }
    if name == "match" { return Token::Match; }
    if name == "struct" { return Token::Struct; }
    if name == "enum" { return Token::Enum; }
    if name == "trait" { return Token::Trait; }
    if name == "impl" { return Token::Impl; }
    if name == "pub" { return Token::Pub; }
    if name == "mod" { return Token::Mod; }
    if name == "use" { return Token::Use; }
    if name == "mut" { return Token::Mut; }
    if name == "as" { return Token::As; }
    if name == "in" { return Token::In; }
    if name == "true" { return Token::True; }
    if name == "false" { return Token::False; }
    if name == "break" { return Token::Break; }
    if name == "continue" { return Token::Continue; }
    Token::Ident(name)
}

// ---- main tokenizer ----

pub fn tokenize(src: str) -> Vec<Token> {
    let tokens: Vec<Token> = vec_new();
    let mut i: i64 = 0;
    let n: i64 = src.len();
    while i < n {
        let b: u8 = src.byte_at(i);

        if is_whitespace(b) {
            i = i + 1;
            continue;
        }

        // Integer literal.
        if is_digit(b) {
            let mut j: i64 = i;
            while j < n && is_digit(src.byte_at(j)) {
                j = j + 1;
            }
            tokens.push(Token::Int(i64::from_str(src[i..j])));
            i = j;
            continue;
        }

        // Identifier-or-keyword.
        if is_alpha(b) {
            let mut j: i64 = i;
            while j < n && is_alnum(src.byte_at(j)) {
                j = j + 1;
            }
            tokens.push(keyword_of(src[i..j]));
            i = j;
            continue;
        }

        // Two-char operators. Lookahead at i+1; if it matches a
        // two-char shape, consume two bytes; otherwise produce
        // the one-char fallback.
        let next: u8 = peek_byte(src, i + 1, n);

        // `==`, `=`, `=>`
        if b == 61u8 {           // '='
            if next == 61u8 {    // "=="
                tokens.push(Token::EqEq);
                i = i + 2;
                continue;
            }
            if next == 62u8 {    // "=>"
                tokens.push(Token::FatArrow);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Eq);
            i = i + 1;
            continue;
        }

        // `!=`, `!`
        if b == 33u8 {           // '!'
            if next == 61u8 {
                tokens.push(Token::BangEq);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Bang);
            i = i + 1;
            continue;
        }

        // `<=`, `<`
        if b == 60u8 {
            if next == 61u8 {
                tokens.push(Token::LtEq);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Lt);
            i = i + 1;
            continue;
        }

        // `>=`, `>`
        if b == 62u8 {
            if next == 61u8 {
                tokens.push(Token::GtEq);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Gt);
            i = i + 1;
            continue;
        }

        // `&&`, `&`
        if b == 38u8 {
            if next == 38u8 {
                tokens.push(Token::AmpAmp);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Amp);
            i = i + 1;
            continue;
        }

        // `||`, `|`
        if b == 124u8 {
            if next == 124u8 {
                tokens.push(Token::PipePipe);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Pipe);
            i = i + 1;
            continue;
        }

        // `::`, `:`
        if b == 58u8 {
            if next == 58u8 {
                tokens.push(Token::ColonColon);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Colon);
            i = i + 1;
            continue;
        }

        // `->`, `-`
        if b == 45u8 {
            if next == 62u8 {
                tokens.push(Token::Arrow);
                i = i + 2;
                continue;
            }
            tokens.push(Token::Minus);
            i = i + 1;
            continue;
        }

        // Plain single-char operators / punctuation.
        let t: Token = match b {
            40u8 => Token::LParen,
            41u8 => Token::RParen,
            123u8 => Token::LBrace,
            125u8 => Token::RBrace,
            43u8 => Token::Plus,
            42u8 => Token::Star,
            47u8 => Token::Slash,
            37u8 => Token::Percent,
            59u8 => Token::Semi,
            44u8 => Token::Comma,
            46u8 => Token::Dot,
            _ => Token::Error(src[i..i+1]),
        };
        tokens.push(t);
        i = i + 1;
    }
    tokens.push(Token::Eof);
    tokens
}

// Convenience for tests: a stable string label per token kind.
// Tests compare against these labels rather than reaching into
// variant payloads, keeping them robust to enum reordering.
pub fn kind_of(t: Token) -> str {
    match t {
        Token::Ident(_) => "Ident",
        Token::Int(_) => "Int",
        Token::LParen => "LParen", Token::RParen => "RParen",
        Token::LBrace => "LBrace", Token::RBrace => "RBrace",
        Token::Plus => "Plus", Token::Minus => "Minus",
        Token::Star => "Star", Token::Slash => "Slash", Token::Percent => "Percent",
        Token::Eq => "Eq", Token::Semi => "Semi", Token::Comma => "Comma",
        Token::Dot => "Dot",
        Token::Lt => "Lt", Token::Gt => "Gt", Token::Bang => "Bang",
        Token::Amp => "Amp", Token::Pipe => "Pipe", Token::Colon => "Colon",
        Token::EqEq => "EqEq", Token::BangEq => "BangEq",
        Token::LtEq => "LtEq", Token::GtEq => "GtEq",
        Token::AmpAmp => "AmpAmp", Token::PipePipe => "PipePipe",
        Token::ColonColon => "ColonColon",
        Token::Arrow => "Arrow", Token::FatArrow => "FatArrow",
        Token::Fn => "Fn", Token::Let => "Let", Token::If => "If",
        Token::Else => "Else", Token::While => "While", Token::For => "For",
        Token::Return => "Return", Token::Match => "Match",
        Token::Struct => "Struct", Token::Enum => "Enum",
        Token::Trait => "Trait", Token::Impl => "Impl",
        Token::Pub => "Pub", Token::Mod => "Mod", Token::Use => "Use",
        Token::Mut => "Mut", Token::As => "As", Token::In => "In",
        Token::True => "True", Token::False => "False",
        Token::Break => "Break", Token::Continue => "Continue",
        Token::Eof => "Eof",
        Token::Error(_) => "Error",
    }
}
