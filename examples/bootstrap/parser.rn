// Session 133 — the parser begins. Consumes Vec<Spanned> from
// the bootstrap lexer (sessions 128-132) and produces an Expr
// AST. Pratt-style precedence climbing handles binary operators
// (`+`, `-`, `*`, `/`, `%`) with correct associativity.
//
// What's HERE (session 133):
//   - Atom expressions: integer literals, identifiers, parens
//   - Unary minus (`-x`)
//   - Binary operators: + - * / %
//   - Pratt precedence: * / % bind tighter than + -
//
// What's NOT yet (future sessions):
//   - Comparison ops, logical ops, bitwise ops, shifts
//   - Function calls
//   - Field access and method calls
//   - String / char / float literals (only Int for now)
//   - Statements, items, modules
//   - Error recovery
//
// The session's purpose is to land a working parser skeleton
// the rest of Phase 2 can build on.
//
// We refer to `lexer::Token` etc. without redeclaring `mod
// lexer` here — main.rn loads both modules as siblings, and
// the resolver makes `lexer::*` reachable from parser.rn.

pub enum BinOp {
    Add, Sub, Mul, Div, Mod,
}

pub enum Expr {
    Num(i64),
    Ident(str),
    Neg(Expr),
    Binary { op: BinOp, lhs: Expr, rhs: Expr },
}

pub struct Parser {
    tokens: Vec<lexer::Spanned>,
    pos: i64,
}

pub fn new_parser(tokens: Vec<lexer::Spanned>) -> Parser {
    Parser { tokens: tokens, pos: 0 }
}

// ---- token cursor ----

fn peek(p: Parser) -> lexer::Token {
    p.tokens.get(p.pos).kind
}

fn advance(p: Parser) -> lexer::Spanned {
    let t: lexer::Spanned = p.tokens.get(p.pos);
    p.pos = p.pos + 1;
    t
}

// ---- binding power ----
//
// Pratt-style: each operator has a left and right binding power.
// We use the same value for both since all our operators are
// left-associative (1 + 2 + 3 = (1 + 2) + 3). Higher values bind
// tighter.
//
// Returns (lbp, rbp) where lbp is "left binding power" — the
// precedence the operator demands of its left side. A binary op
// only fires if its lbp > the surrounding context's min_bp.

fn binop_bp(t: lexer::Token) -> i64 {
    match t {
        lexer::Token::Plus => 10,
        lexer::Token::Minus => 10,
        lexer::Token::Star => 20,
        lexer::Token::Slash => 20,
        lexer::Token::Percent => 20,
        _ => 0,   // not a binop
    }
}

fn binop_of(t: lexer::Token) -> BinOp {
    match t {
        lexer::Token::Plus => BinOp::Add,
        lexer::Token::Minus => BinOp::Sub,
        lexer::Token::Star => BinOp::Mul,
        lexer::Token::Slash => BinOp::Div,
        lexer::Token::Percent => BinOp::Mod,
        _ => BinOp::Add,   // unreachable in well-formed input
    }
}

// ---- expression parsing ----

pub fn parse_expr(p: Parser) -> Expr {
    parse_bp(p, 0)
}

// Pratt's core loop: parse an atom (or unary-prefix expr) for
// the left side, then while the next token is a binop with
// binding power > min_bp, consume it and parse the right side
// at bp+1 (left-associative).
fn parse_bp(p: Parser, min_bp: i64) -> Expr {
    let lhs: Expr = parse_unary(p);
    parse_binops(p, lhs, min_bp)
}

fn parse_binops(p: Parser, lhs: Expr, min_bp: i64) -> Expr {
    let bp: i64 = binop_bp(peek(p));
    if bp == 0 || bp <= min_bp {
        return lhs;
    }
    let op_tok: lexer::Spanned = advance(p);
    let op: BinOp = binop_of(op_tok.kind);
    let rhs: Expr = parse_bp(p, bp);
    let combined: Expr = Expr::Binary { op: op, lhs: lhs, rhs: rhs };
    parse_binops(p, combined, min_bp)
}

fn parse_unary(p: Parser) -> Expr {
    let t: lexer::Token = peek(p);
    match t {
        lexer::Token::Minus => {
            advance(p);
            // Unary minus binds tighter than any binop in our
            // table; recurse with bp 30 so it captures just the
            // atom (or another unary-neg).
            let inner: Expr = parse_bp(p, 30);
            Expr::Neg(inner)
        }
        _ => parse_atom(p),
    }
}

fn parse_atom(p: Parser) -> Expr {
    let s: lexer::Spanned = advance(p);
    match s.kind {
        lexer::Token::Int(v, _) => Expr::Num(v),
        lexer::Token::Ident(name) => Expr::Ident(name),
        lexer::Token::LParen => {
            let inner: Expr = parse_expr(p);
            // Expect a closing RParen. If it isn't there, just
            // return the inner — error recovery is out of scope
            // for session 133.
            let close: lexer::Token = peek(p);
            match close {
                lexer::Token::RParen => { advance(p); inner }
                _ => inner,
            }
        }
        _ => Expr::Num(-1),   // sentinel for unexpected; tests catch this
    }
}

// ---- evaluator (for testing) ----
//
// A tiny evaluator that walks an Expr and computes its i64
// value. Identifiers all resolve to 0 (we don't have an
// environment yet). Useful as a "did the AST come out right?"
// check — `eval(parse("1 + 2 * 3"))` should be 7.

pub fn eval(e: Expr) -> i64 {
    match e {
        Expr::Num(v) => v,
        Expr::Ident(_) => 0,
        Expr::Neg(inner) => 0 - eval(inner),
        Expr::Binary { op, lhs, rhs } => {
            let l: i64 = eval(lhs);
            let r: i64 = eval(rhs);
            match op {
                BinOp::Add => l + r,
                BinOp::Sub => l - r,
                BinOp::Mul => l * r,
                BinOp::Div => l / r,
                BinOp::Mod => l % r,
            }
        }
    }
}
