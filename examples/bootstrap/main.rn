// Demo entry point exercising both the bootstrap lexer (sessions
// 128-132) and the bootstrap parser (session 133). Parses an
// arithmetic expression, evaluates the resulting AST, returns
// the value.
//
// Run: cargo run -- run examples/bootstrap/main.rn

mod lexer;
mod parser;

fn main() -> i64 {
    // (1 + 2 * 3) - (10 / 5) = 7 - 2 = 5
    let src: str = "(1 + 2 * 3) - (10 / 5)";
    let toks: Vec<lexer::Spanned> = lexer::tokenize(src);
    let p: parser::Parser = parser::new_parser(toks);
    let ast: parser::Expr = parser::parse_expr(p);
    parser::eval(ast)
}
