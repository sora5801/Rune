// Demo entry point for the Phase 2 bootstrap lexer.
// Tokenizes a snippet that exercises identifiers, integers,
// operators, keywords, string literals, and char literals.
// Returns the total token count so the caller can confirm the
// lexer ran end-to-end.
//
// Run: cargo run -- run examples/bootstrap/main.rn

mod lexer;

fn main() -> i64 {
    let src: str = "let s = \"hi\n\"; let c = 'a';";
    // Expected tokens: Let Ident("s") Eq Str("hi\n") Semi
    //                  Let Ident("c") Eq Char('a') Semi Eof = 11
    let toks: Vec<lexer::Token> = lexer::tokenize(src);
    toks.len()
}
