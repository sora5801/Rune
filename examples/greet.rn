// greet.rn — polymorphic `print`, string concat, and string methods.
// Run with `rune run examples/greet.rn`
// or compile with `rune build examples/greet.rn --release`.

fn greet(name: str) -> str {
    "Hello, " + name + "!"
}

fn main() -> i64 {
    let names = ["world", "Rune", "Cranelift"];
    let mut count = 0;
    let mut total_bytes = 0;
    for n in names {
        let g = greet(n);
        print(g);
        total_bytes = total_bytes + g.len();
        count = count + 1;
    }
    print("greeted (count, total bytes):");
    print(count);
    print(total_bytes);
    0
}
