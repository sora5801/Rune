// greet.rn — polymorphic `print` over both strings and integers.
// Run with `rune run examples/greet.rn`
// or compile with `rune build examples/greet.rn --release`.

fn greet(name: str) -> str {
    "Hello, " + name + "!"
}

fn main() -> i64 {
    let names = ["world", "Rune", "Cranelift"];
    let mut count = 0;
    for n in names {
        print(greet(n));
        count = count + 1;
    }
    print("Total greeted:");
    print(count);
    0
}
