// greet.rn — string concatenation demo.
// Run with `rune run examples/greet.rn`
// or compile with `rune build examples/greet.rn --release`.

fn greet(name: str) -> str {
    "Hello, " + name + "!"
}

fn main() -> i64 {
    let names = ["world", "Rune", "Cranelift"];
    for n in names {
        print_str(greet(n));
    }
    0
}
