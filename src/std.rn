/* Rune standard prelude.

   This module is written in Rune itself and embedded into the
   compiler (via include_str!). It is prepended to every program
   before resolution, so `std::` items are always in scope.

   Generic functions here are zero-cost when unused — the
   monomorphizer only emits the specializations a program actually
   calls, and drops the generic originals. The handful of concrete
   helpers (min/max/abs/clamp) compile into every binary. */
pub mod std {
    /* The optional type — `Some(value)` or `None`. */
    pub enum Option<T> { Some(T), None }

    /* The result type — `Ok(value)` or `Err(error)`. */
    pub enum Result<T, E> { Ok(T), Err(E) }

    /* The iterator protocol. Implement `Iterator` on a struct and
       `for x in it { ... }` desugars to repeated `it.next()` calls,
       stopping when `next` returns `None`.

       Each call to `next` mutates the struct's fields in place via
       FieldAssign — Rune has no mutable references, so iteration
       state lives inside the struct and the method writes through
       `self.field = ...`. */
    pub trait Iterator {
        type Item;
        fn next(self: dyn Iterator) -> Option<Self::Item>;
        /* Session 071: default-body method. Drains the iterator into
           a Vec by calling `self.next()` repeatedly until `None`.
           Every Iterator-implementing type inherits this — no need
           to override unless you want a custom collect strategy.
           `Self` inside the body refers to the concrete impl type
           (VecIter<T>, Map<I, F, U>, etc.); monomorphization
           specializes per Self at each call site. */
        fn collect(self: Self) -> Vec<Self::Item> {
            let v: Vec<Self::Item> = vec_new();
            while true {
                match self.next() {
                    Option::Some(x) => { v.push(x); }
                    Option::None => { break; }
                }
            }
            v
        }
        /* Session 076: count the elements the iterator yields.
           Every Iterator impl inherits this; the monomorphizer
           specializes per Self, so `self.next()` dispatches to
           the impl's concrete next at each call site. */
        fn count(self: Self) -> i64 {
            let mut n: i64 = 0;
            while true {
                match self.next() {
                    Option::Some(_) => { n = n + 1; }
                    Option::None => { break; }
                }
            }
            n
        }
        /* Sum the elements. v0.x assumes `Self::Item` is `i64` —
           the body's `total + x` is i64 arithmetic and codegen
           rejects non-i64 specializations. A future session
           with numeric trait bounds (`Self::Item: Add<Output =
           Self::Item>`) would generalize this. */
        fn sum(self: Self) -> i64 {
            let mut total: i64 = 0;
            while true {
                match self.next() {
                    Option::Some(x) => { total = total + x; }
                    Option::None => { break; }
                }
            }
            total
        }
        /* Session 079: return the smallest element, or `None` if
           the iterator is empty. v0.x assumes `Self::Item = i64`
           (same constraint sum has) — the body's comparison uses
           i64 ordering. Generalizing to any ordered/numeric type
           needs a real `Ord` / `Numeric` trait bound, deferred. */
        fn min(self: Self) -> Option<i64> {
            let mut best: Option<i64> = Option::None;
            while true {
                match self.next() {
                    Option::Some(x) => {
                        match best {
                            Option::Some(b) => {
                                if x < b { best = Option::Some(x); }
                            }
                            Option::None => { best = Option::Some(x); }
                        }
                    }
                    Option::None => { break; }
                }
            }
            best
        }
        /* Session 079: return the largest element, or `None` if
           empty. Same i64-only constraint as `min`. */
        fn max(self: Self) -> Option<i64> {
            let mut best: Option<i64> = Option::None;
            while true {
                match self.next() {
                    Option::Some(x) => {
                        match best {
                            Option::Some(b) => {
                                if x > b { best = Option::Some(x); }
                            }
                            Option::None => { best = Option::Some(x); }
                        }
                    }
                    Option::None => { break; }
                }
            }
            best
        }
        /* Session 077: `.filter(p)` as a default method.
           Method-level generic `P: Fn1<Self::Item, bool>` lets
           the user pass any closure or fn-pointer with the
           right signature. Constructs a `Filter<Self, P>` —
           the rest of the pipeline (Iterator impl, monomorphize,
           codegen) was already in place. */
        fn filter<P: Fn1<Self::Item, bool>>(self: Self, p: P)
            -> Filter<Self, P>
        {
            Filter { iter: self, pred: p }
        }
        /* Session 078: `.map(f)` as a default method. The `U`
           generic sits only in F's `Fn1<Self::Item, U>` bound,
           not in the param list — session 078's bound-
           propagation cascade reads U from F's call signature
           at call time. */
        fn map<F: Fn1<Self::Item, U>, U>(self: Self, f: F)
            -> Map<Self, F, U>
        {
            Map { iter: self, f: f }
        }
        /* Session 080: `.fold(init, f)` reduces the iterator with
           a binary closure. `init` pins the accumulator type `U`;
           `f: Fn2<U, Self::Item, U>` takes the running accumulator
           and the next item, returns the next accumulator.
           Closure args generally need explicit type annotations
           (`|acc: i64, x: i64| ...`) because method-call sites
           don't yet flow bidirectional hints into closure args. */
        fn fold<F: Fn2<U, Self::Item, U>, U>(self: Self, init: U, f: F) -> U {
            let mut acc: U = init;
            while true {
                match self.next() {
                    Option::Some(x) => { acc = f.call(acc, x); }
                    Option::None => { break; }
                }
            }
            acc
        }
    }

    /* One-argument callable: a closure literal `|x| body` that
       captures from the enclosing scope synthesizes a fresh
       struct implementing this trait (the closure-as-struct
       design). Each closure site has its own concrete impl with
       `A` and `R` pinned to the closure's actual signature; the
       call dispatches via the synthesized `call` method. Named
       `fn` items don't implement `Fn1` explicitly — they remain
       `Ty::Fn` pointers, called via the existing IndirectCall
       path. */
    pub trait Fn1<A, R> {
        fn call(self: Self, a: A) -> R;
    }

    /* Two-argument callable. Used by `.fold(init, f)` where the
       closure's first arg is the accumulator and the second is the
       next item. Same closure-as-struct shape as Fn1: each two-arg
       closure site synthesizes a fresh struct + a `call(self, a, b)
       -> r` method. The bound-propagation cascade (session 080)
       handles Fn2 the same way as Fn1 — the arity comparisons
       are generic. */
    pub trait Fn2<A, B, R> {
        fn call(self: Self, a: A, b: B) -> R;
    }

    /* Conversion from `Self` to `T`. The `?` operator calls
       `err.into()` when the inner result's error type doesn't
       match the surrounding function's error type. The user
       implements `Into<TargetErr>` on each source error type
       (`impl Into<AppErr> for IoErr { fn into(self: IoErr) ->
       AppErr { AppErr::Io(self) } }`) and the conversion lands
       automatically at `?` sites. v0.x: single-impl assumption
       per source type (multi-impl `Into<A> for X` AND `Into<B>
       for X` would be ambiguous since the impl_methods table
       keys methods by name alone). */
    pub trait Into<T> {
        fn into(self: Self) -> T;
    }

    /* Iterator over an integer range — holds the next value to
       yield and the (exclusive) upper bound. A `start..end`
       expression outside a for-loop lowers to a `RangeIter`
       struct literal; the for-over-range fast path still
       emits the counted-loop codegen directly (no struct
       allocation, no method dispatch) for `for i in start..end`. */
    pub struct RangeIter {
        cur: i64,
        end: i64,
    }

    pub impl Iterator for RangeIter {
        type Item = i64;
        fn next(self: RangeIter) -> Option<i64> {
            if self.cur < self.end {
                let v: i64 = self.cur;
                self.cur = self.cur + 1;
                Option::Some(v)
            } else {
                Option::None
            }
        }
    }

    /* Iterator over the elements of a `Vec<T>`. Holds the source
       vec and the current index; constructed by the builtin
       `vec.iter()` method. */
    pub struct VecIter<T> {
        vec: Vec<T>,
        idx: i64,
    }

    pub impl<T> Iterator for VecIter<T> {
        type Item = T;
        fn next(self: VecIter<T>) -> Option<T> {
            if self.idx < self.vec.len() {
                let v: T = self.vec.get(self.idx);
                self.idx = self.idx + 1;
                Option::Some(v)
            } else {
                Option::None
            }
        }
    }

    /* Iterator over a HashMap's keys. Session 068 introduces it
       alongside the runtime's tombstone-based remove. The body
       walks slot indices 0..cap, skipping non-live slots
       (occupied != 1, including tombstones). The user calls
       `m.keys()` to construct one; the iterator yields i64 keys
       in arbitrary order (hash-driven, not insertion-driven).
       For values, the user looks each key up: `for k in m.keys()
       { let v = m.get(k); ... }`. */
    pub struct HashMapKeysIter<V> {
        map: HashMap<i64, V>,
        cursor: i64,
    }

    pub impl<V> Iterator for HashMapKeysIter<V> {
        type Item = i64;
        fn next(self: HashMapKeysIter<V>) -> Option<i64> {
            let cap: i64 = hashmap_cap(self.map);
            while self.cursor < cap {
                if hashmap_is_live_at(self.map, self.cursor) {
                    let k: i64 = hashmap_key_at(self.map, self.cursor);
                    self.cursor = self.cursor + 1;
                    return Option::Some(k);
                }
                self.cursor = self.cursor + 1;
            }
            Option::None
        }
    }

    /* Session 075: entries iterator. Yields `(key, value)` tuples
       for each live slot in the map. The lowerer's `.entries()`
       builtin mirrors `.keys()`'s desugar — produces a struct lit
       holding the map ARC and a zero cursor. Same i64-key
       restriction as the keys iter (str-key entries iter is a
       future session). */
    pub struct HashMapEntriesIter<V> {
        map: HashMap<i64, V>,
        cursor: i64,
    }

    pub impl<V> Iterator for HashMapEntriesIter<V> {
        type Item = (i64, V);
        fn next(self: HashMapEntriesIter<V>) -> Option<(i64, V)> {
            let cap: i64 = hashmap_cap(self.map);
            while self.cursor < cap {
                if hashmap_is_live_at(self.map, self.cursor) {
                    let k: i64 = hashmap_key_at(self.map, self.cursor);
                    let v: V = hashmap_val_at(self.map, self.cursor);
                    self.cursor = self.cursor + 1;
                    return Option::Some((k, v));
                }
                self.cursor = self.cursor + 1;
            }
            Option::None
        }
    }

    /* Session 083: str-keyed counterparts of the two iterators
       above. The runtime layout is identical (one descriptor type,
       branched on `key_kind`); only the Rune-side Key type differs.
       Lowerer's `.keys()` / `.entries()` builtins dispatch on the
       map's K (Ty::Str → these, Ty::Int(I64) → the i64 variants). */
    pub struct HashMapStrKeysIter<V> {
        map: HashMap<str, V>,
        cursor: i64,
    }

    pub impl<V> Iterator for HashMapStrKeysIter<V> {
        type Item = str;
        fn next(self: HashMapStrKeysIter<V>) -> Option<str> {
            let cap: i64 = hashmap_cap(self.map);
            while self.cursor < cap {
                if hashmap_is_live_at(self.map, self.cursor) {
                    let k: str = hashmap_key_at(self.map, self.cursor);
                    self.cursor = self.cursor + 1;
                    return Option::Some(k);
                }
                self.cursor = self.cursor + 1;
            }
            Option::None
        }
    }

    pub struct HashMapStrEntriesIter<V> {
        map: HashMap<str, V>,
        cursor: i64,
    }

    pub impl<V> Iterator for HashMapStrEntriesIter<V> {
        type Item = (str, V);
        fn next(self: HashMapStrEntriesIter<V>) -> Option<(str, V)> {
            let cap: i64 = hashmap_cap(self.map);
            while self.cursor < cap {
                if hashmap_is_live_at(self.map, self.cursor) {
                    let k: str = hashmap_key_at(self.map, self.cursor);
                    let v: V = hashmap_val_at(self.map, self.cursor);
                    self.cursor = self.cursor + 1;
                    return Option::Some((k, v));
                }
                self.cursor = self.cursor + 1;
            }
            Option::None
        }
    }

    /* Adapter: yields `f(x)` for each `x` in the wrapped iterator.
       `F` is any one-argument callable — typically a closure literal
       (capturing or not) or a synthesized fn wrapper. The Fn1 bound
       pins the call signature; `self.f.call(x)` dispatches via the
       impl. After monomorphization, the call site is rewritten to a
       direct Call when F is concrete. */
    pub struct Map<I, F, U> {
        iter: I,
        f: F,
    }

    pub impl<I: Iterator, F: Fn1<I::Item, U>, U> Iterator for Map<I, F, U> {
        type Item = U;
        fn next(self: Map<I, F, U>) -> Option<U> {
            match self.iter.next() {
                Option::Some(x) => Option::Some(self.f.call(x)),
                Option::None    => Option::None,
            }
        }
    }

    /* Adapter: yields only those `x` for which `pred.call(x)` is true. */
    pub struct Filter<I, P> {
        iter: I,
        pred: P,
    }

    pub impl<I: Iterator, P: Fn1<I::Item, bool>> Iterator for Filter<I, P> {
        type Item = I::Item;
        fn next(self: Filter<I, P>) -> Option<I::Item> {
            while true {
                match self.iter.next() {
                    Option::Some(x) => {
                        if self.pred.call(x) {
                            return Option::Some(x);
                        }
                    }
                    Option::None => { return Option::None; }
                }
            }
            // Unreachable; the while-true loop only exits via return.
            Option::None
        }
    }

    /* Drain an iterator into a `Vec<T::Item>`. Free function (not
       a method): chained `.collect()` would need default-method
       trait bodies, which v0.x doesn't have — so the user writes
       `collect(v.iter().map(double))` instead. */
    pub fn collect<T: Iterator>(it: T) -> Vec<T::Item> {
        let v: Vec<T::Item> = vec_new();
        for x in it {
            v.push(x);
        }
        v
    }

    /* Return the contained value, or `default` when the Option is
       None. */
    pub fn unwrap_or<T>(o: Option<T>, default: T) -> T {
        match o {
            Option::Some(x) => x,
            Option::None => default,
        }
    }

    /* True when the Option holds a value. */
    pub fn is_some<T>(o: Option<T>) -> bool {
        match o {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    /* True when the Option is empty. */
    pub fn is_none<T>(o: Option<T>) -> bool {
        match o {
            Option::Some(_) => false,
            Option::None => true,
        }
    }

    /* Return the Ok value, or `default` when the Result is Err. */
    pub fn ok_or<T, E>(r: Result<T, E>, default: T) -> T {
        match r {
            Result::Ok(x) => x,
            Result::Err(_) => default,
        }
    }

    /* True when the Result holds an Ok value. */
    pub fn is_ok<T, E>(r: Result<T, E>) -> bool {
        match r {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    /* True when the Result holds an Err value. */
    pub fn is_err<T, E>(r: Result<T, E>) -> bool {
        match r {
            Result::Ok(_) => false,
            Result::Err(_) => true,
        }
    }

    /* The smaller of two i64 values. */
    pub fn min(a: i64, b: i64) -> i64 {
        if a < b { a } else { b }
    }

    /* The larger of two i64 values. */
    pub fn max(a: i64, b: i64) -> i64 {
        if a > b { a } else { b }
    }

    /* Absolute value of an i64. */
    pub fn abs(x: i64) -> i64 {
        if x < 0 { -x } else { x }
    }

    /* Clamp `x` into the inclusive range `[lo, hi]`. */
    pub fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
        if x < lo {
            lo
        } else {
            if x > hi { hi } else { x }
        }
    }
}
